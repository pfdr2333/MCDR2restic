{
  "command": {
    "aliases": [
      "!!m2r"
    ],
    "permission_level": 3,
    "root": "!!restic"
  },
  "config_version": 12,
  "custom_webhook": {
    "enabled": false,
    "headers": {},
    "message_prefix": "[MCDR2Restic]",
    "payload": {
      "content": "{message}"
    },
    "send_timeout_seconds": 10,
    "url": ""
  },
  "discord": {
    "avatar_url": "",
    "enabled": false,
    "mention_everyone": false,
    "mention_role_ids": [],
    "mention_user_ids": [],
    "message_prefix": "[MCDR2Restic]",
    "send_timeout_seconds": 10,
    "username": "MCDR2Restic",
    "webhook_url": ""
  },
  "enabled": true,
  "force_schedule": {
    "cron_expression": "0",
    "interval_seconds": 0
  },
  "language": "en_us",
  "maintenance_schedule": {
    "cron_expression": "0 0 3 * * *",
    "interval_seconds": 0
  },
  "messages": {
    "backup_failure": "{prefix} Backup problem\nTrigger: {label}\nStatus: {status}\nDetail: {detail}\nEnd time: {end_time}",
    "backup_not_ready": "{prefix} Backup skipped\n{message}",
    "backup_skip_no_player": "{prefix} Backup skipped\nNo players joined or left during this period, and nobody was online at the final check",
    "backup_skipped": "{prefix} Scheduled backup skipped\n{message}",
    "backup_stale_warning": "{prefix} No successful backup after {hours} hours of server uptime (last success: {last_success})\nThe last {skips} scheduled backups were deferred because {current}/{max_online} players online reached the gate threshold\nRunning a backup now is unsafe: save-off must stay active for the whole run, and a long freeze at peak can pile unsaved chunks up in JVM memory and exhaust the server\nWait for the player count to drop below the threshold, run {root} backup manually during off-peak hours, or pin a night-time fallback with force_schedule\nIf you are sure memory headroom is sufficient and accept the crash risk, set backup_player_gate_max_online to 0 to disable the gate\nDocumentation: {doc_url}",
    "backup_start": "{prefix} Backup started\nTrigger: {label}\nTime: {start_time}",
    "backup_success": "{prefix} Backup completed\nTrigger: {label}\nDuration: {duration_seconds}s\nEnd time: {end_time}",
    "maintenance_failed": "{prefix} Repository maintenance failed\n{message}\nTime: {time}",
    "maintenance_skipped": "{prefix} Repository maintenance skipped\n{message}\nTime: {time}",
    "schedule_config_error": "{prefix} Schedule configuration error\nFailed to calculate the next backup time: {error}",
    "staging_hint": "[beta] A staging repository can shorten the save-off freeze window: write to a local repository first, then copy to the remote repository asynchronously.\nIt is disabled by default, and interfaces or behavior may change, so do not rely on it as the only backup.\nCosts: reserve local disk space roughly equal to the world size; the first enable is still a full local write; the remote copy may lag; configuration and troubleshooting are more complex.\nDocumentation: {documentation_url}\nEnable: set staging.enabled: true and staging.repository in config.yml; see the documentation for details.",
    "staging_remote_stale": "[beta] The staging repository's remote copy is about {hours} hours behind (local latest snapshot {local_time}, remote latest snapshot {remote_time}). Check remote reachability and copy status."
  },
  "minecraft": {
    "save_all_command": "save-all flush",
    "save_all_done_patterns": [
      "Saved the game",
      "Saved the world"
    ],
    "save_off_command": "save-off",
    "save_on_command": "save-on",
    "wait_after_save_all_seconds": 10,
    "wait_after_save_off_seconds": 2,
    "wait_after_save_on_seconds": 1,
    "wait_for_save_all_completion": true
  },
  "notification": {
    "notify_on_failure": true,
    "notify_on_skip": false,
    "notify_on_start": true,
    "notify_on_success": true,
    "stale_backup_warning_hours": 24
  },
  "onebot": {
    "access_token": "",
    "admin_qqs": [
      123456789
    ],
    "connect_timeout_seconds": 10,
    "enabled": false,
    "message_prefix": "[MCDR2Restic]",
    "reconnect_interval_seconds": 5,
    "send_timeout_seconds": 10,
    "use_header_auth": false,
    "ws_url": "ws://127.0.0.1:8777"
  },
  "restic": {
    "auto_init_local_repository": true,
    "backup_command": [
      "backup",
      "./server/world",
      "--tag",
      "minecraft",
      "--host",
      "mcdr2Restic"
    ],
    "disk_check_enabled": true,
    "disk_check_min_free_percent": 10.0,
    "environment": {},
    "error_regexes": [
      "(?i)^fatal:",
      "(?i)^error(?:s)?\\b(?!:\\s*0\\b)",
      "(?i)\\b(permission denied|input/output error|read error|unreadable|failed to|unable to)\\b",
      "(?i)\\bno such file or directory\\b"
    ],
    "executable": "./config/mcdr2restic/restic",
    "ignore_error_regexes": [
      "(?i)errors?:\\s*0\\b",
      "(?i)no errors? (?:were )?found"
    ],
    "maintenance_commands": [
      [
        "forget",
        "--keep-within",
        "1d",
        "--keep-daily",
        "7",
        "--prune"
      ]
    ],
    "max_output_chars_in_notification": 1800,
    "password": "123456",
    "password_file": "",
    "progress_interval_seconds": 5,
    "repository": "./restic-repo",
    "success_exit_codes": [
      0
    ],
    "timeout_seconds": 0,
    "use_path_restic": false,
    "working_directory": ""
  },
  "restore": {
    "pre_restore_backup_tag": "mcdr2restic-pre-restore",
    "start_timeout_seconds": 120
  },
  "schedule": {
    "backup_player_gate_max_online": 5,
    "backup_player_gate_overlimit_seconds": 600,
    "cron_expression": "0 0 0,3,6,9,12,15,18,21 * * *",
    "interval_seconds": 0,
    "max_defer_seconds": 0,
    "min_gap_seconds": 1800,
    "online_check_command": "list",
    "require_player_activity_in_wait_period": true
  },
  "snapshot_cache": {
    "database": "snapshots.sqlite3",
    "enabled": true,
    "page_size": 10,
    "query_timeout_seconds": 30
  },
  "staging": {
    "cache_dir": "",
    "copy_limit_upload_kib": 0,
    "copy_retry_backoff_seconds": [
      60,
      300,
      900
    ],
    "copy_retry_max": 3,
    "deep_prune_interval_days": 7,
    "deep_prune_max_unused": "0",
    "emergency_prune_timeout_seconds": 120,
    "enabled": false,
    "keep_last": 2,
    "min_free_percent_after": 10,
    "password": "",
    "password_file": "./config/mcdr2restic/staging-password.txt",
    "prune_max_repack_size": "20G",
    "prune_max_unused": "5%",
    "remote_stale_warning_hours": 24,
    "repository": ""
  },
  "update_check": {
    "api_url": "https://api.github.com/repos/pfdr2333/MCDR2restic/releases/latest",
    "check_on_startup": true,
    "daily_time": "00:00",
    "enabled": true,
    "proxy_prefixes": [
      "https://gh-proxy.com/",
      "https://ghproxy.net/"
    ],
    "release_page_url": "https://github.com/pfdr2333/MCDR2restic/releases/latest",
    "timeout_seconds": 10
  }
}
